{
  "name": "qma-cli",
  "version": "2.1.0",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "qma": "bin/qma.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./circle-wallet": {
      "types": "./dist/wallets/circleSigner.d.ts",
      "import": "./dist/wallets/circleSigner.js"
    }
  },
  "type": "module",
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "description": "Autonomous buyer-agent CLI for the QMA marketplace on Arc.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node scripts/session_smoke.mjs && node scripts/payment_executor_smoke.mjs",
    "clean": "node scripts/clean.mjs",
    "start:worker": "npm run build && node dist/worker.js"
  },
  "dependencies": {
    "viem": "^2.48.11"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.6.3"
  }
}