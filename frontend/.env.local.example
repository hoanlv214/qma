VITE_QMA_API_BASE_URL=http://127.0.0.1:8000
VITE_QMA_ENV=local_react_dev
VITE_QMA_SYNTHETIC_RUN=true

# Network Mode Profile (Testnet vs Mainnet)
# Set to "testnet" or "mainnet" to automatically switch all chain IDs, RPCs, explorers,
# Gateway contracts, and CCTP TokenMessengers without altering individual addresses.
VITE_NETWORK_MODE=mainnet

# Arc Network Overrides (Optional - defaults are auto-resolved from VITE_NETWORK_MODE)
# For Mainnet:
# VITE_ARC_CHAIN_ID=5042
# VITE_ARC_CHAIN_NAME="Arc Mainnet"
# VITE_ARC_RPC_URL=https://rpc.mainnet.arc.io
# VITE_ARC_EXPLORER=https://explorer.arc.io
# For Testnet:
# VITE_ARC_CHAIN_ID=5042002
# VITE_ARC_CHAIN_NAME="Arc Testnet"
# VITE_ARC_RPC_URL=https://rpc.testnet.arc.network
# VITE_ARC_EXPLORER=https://testnet.arcscan.app

