# ==============================================================================
# QMA Deployment & Secrets Configuration
#
# NOTE: Public blockchain parameters (Chain IDs, RPCs, Explorers, Canonical
# Contracts, CCTP Messengers) live in `config/networks.json`.
# Business constants (Pricing, Fees, TTLs, Yield, Swap params) live in `config/app.json`.
#
# This file only holds:
# 1. Network selection mode (mainnet vs testnet)
# 2. Deployment wiring URLs & Ports
# 3. Private keys, API keys & Secrets
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Network Mode Selection
# Switch seamlessly between "mainnet" and "testnet". All contracts, chain IDs,
# and RPC endpoints are loaded automatically from `config/networks.json`.
# ------------------------------------------------------------------------------
QMA_NETWORK_MODE=mainnet
VITE_NETWORK_MODE=mainnet

# ------------------------------------------------------------------------------
# 2. Deployment Wiring & Service URLs
# ------------------------------------------------------------------------------
# Backend API & Gateway inter-service connections
QMA_ARC_GATEWAY_URL=http://127.0.0.1:3000
QMA_BACKEND_INTERNAL_URL=http://127.0.0.1:8000
API_BASE_URL=http://127.0.0.1:8000
QMA_API_URL=http://127.0.0.1:8000

# Public MCP Gateway (optional for Claude/ChatGPT integrations)
QMA_MCP_API_BASE_URL=https://qma-api.onrender.com
QMA_MCP_CONNECT_BASE_URL=https://qma.vercel.app

# Database & Storage (Supabase Postgres, leave blank for isolated JSON ledgers)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SCHEMA=public

# Optional custom data directory (defaults to repo root)
# QMA_DATA_DIR=./data

# ------------------------------------------------------------------------------
# 3. Deployment Wallet Overrides (Optional - defaults in config/app.json)
# ------------------------------------------------------------------------------
# QMA_PLATFORM_TREASURY_ADDRESS=0x...
# QMA_ARC_SELLER_ADDRESS=0x...
# QMA_ADMIN_WALLET=0x...
# QMA_FUNDING_MEMORY_OWNER_WALLET=0x...
# QMA_OI_MEMORY_OWNER_WALLET=0x...
# QMA_WITHDRAW_RELAYER_ADDRESS=0x...

# ------------------------------------------------------------------------------
# 4. Secrets & Private Keys (NEVER commit real keys)
# ------------------------------------------------------------------------------
# Server internal HMAC and token signing secrets
QMA_ACCESS_TOKEN_SECRET=replace-with-a-secure-random-secret
QMA_SPLIT_LEG_URL_SECRET=replace-with-a-secure-random-secret
QMA_SPLIT_RECEIPT_SECRET=replace-with-a-secure-random-secret
QMA_ARC_GATEWAY_INTERNAL_SECRET=replace-with-a-secure-random-secret
QMA_ADMIN_TOKEN=replace-with-admin-review-token

# Circle Developer-Controlled Wallets (Arc Gateway sidecar)
CIRCLE_CONSOLE_API_KEY=
CIRCLE_ENTITY_SECRET=
TREASURY_WALLET_ID=
# If treasury is an SCA, provide delegate:
# QMA_GATEWAY_DELEGATE_WALLET_ID=
# QMA_GATEWAY_DELEGATE_ADDRESS=

# Relayer & Autonomous Agent Private Keys
QMA_WITHDRAW_RELAYER_PRIVATE_KEY=
GENLAYER_PRIVATE_KEY=
AGENT_PRIVATE_KEY=

# LLM Providers (Gemini / OpenAI)
GEMINI_API_KEY=
OPENAI_API_KEY=
